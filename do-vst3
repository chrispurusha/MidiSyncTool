#!/bin/zsh
# Build the MidiSyncTool VST3 plug-in.
#
# A script rather than an Xcode target, for the reason all the sibling projects' do-vst3 is one: a
# .vst3 is a bundle around a single dylib and needs no build system to say so.
#
# DELIBERATELY MINIMAL AT THIS STAGE. No SynthLib, no FreeType, no editor - this first plug-in
# exists to answer one question, which is what timing information Ableton actually hands us and
# whether it makes sense. It draws nothing, so it needs none of the drawing stack, and adding that
# later is a matter of extending this list rather than unpicking anything.

set -e

SDK="${VST3_SDK:-$HOME/Documents/vst3sdk}"
HERE="$(cd "$(dirname "$0")" && pwd)"
DEFAULT_OUT="$HERE/build/MidiSyncTool.vst3"
OUT="${MST_VST3_OUT:-$DEFAULT_OUT}"
BIN="$OUT/Contents/MacOS/MidiSyncTool"
DEPLOYMENT_TARGET=11.5

if [[ ! -d "$SDK/pluginterfaces" ]]; then
    print -u2 "error: VST3 SDK not found at $SDK"
    print -u2 "       set VST3_SDK to its location"
    exit 1
fi

C_SOURCES=(
    "$HERE/src/msLog.c"
    "$HERE/src/msMidi.c"
    "$HERE/src/msClock.c"
    "$HERE/src/msClockIn.c"
    "$HERE/src/msStats.c"
    "$HERE/src/msDetect.c"
    "$HERE/src/msProbe.c"
    "$HERE/vst3/msStatus.c"
    "$HERE/vst3/msDraw.c"
    "$HERE/vst3/msAppStubs.c"

    # SynthLib, and only the parts a plug-in panel needs - the same manual list GenBridge keeps, and
    # manual for the same reason: nothing here is a synchronised folder, so a new SynthLib file has
    # to be added deliberately.
    "$HERE/SynthLib/src/utilsGraphics.c"
    "$HERE/SynthLib/src/renderBackend.c"
    "$HERE/SynthLib/src/renderBackendGL.c"
    "$HERE/SynthLib/src/geometry.c"
    "$HERE/SynthLib/src/utils.c"
    "$HERE/SynthLib/src/synthlibHost.c"
    "$HERE/SynthLib/src/synthlibVersion.c"
    "$HERE/SynthLib/src/clickRegion.c"
    "$HERE/SynthLib/src/inputState.c"
    "$HERE/SynthLib/src/contextMenu.c"
)

# Objective-C. Plain, not Objective-C++: the drawing surface needs the runtime but no C++, and
# keeping it separate confines C++ to the one file that genuinely has to speak it.
OBJC_SOURCES=(
    "$HERE/vst3/msView.m"
    "$HERE/SynthLib/src/renderBackendMetal.m"
)

# Objective-C++ for the editor: it builds an AppKit view and hands it to the host, and IPlugView is
# a C++ interface, so this one file has to speak both.
OBJCPP_SOURCES=(
    "$HERE/vst3/msEditor.mm"
)

CPP_SOURCES=(
    "$HERE/vst3/msVst3.cpp"
    "$SDK/pluginterfaces/base/funknown.cpp"
    "$SDK/pluginterfaces/base/coreiids.cpp"
    "$SDK/public.sdk/source/vst/vstinitiids.cpp"

    # IPlugView's own IID lives here rather than in coreiids.cpp - the editor needs it, a plug-in
    # without one does not.
    "$SDK/public.sdk/source/common/commoniids.cpp"
)

# glfw is here for its HEADERS ONLY - SynthLib's key and mouse constants come from them.
INCLUDES=(-I"$HERE/src" -I"$HERE/vst3" -I"$HERE/SynthLib/src" -I"$SDK"
          -I"$HERE/SynthLib/ThirdParty/glfw/include"
          -I"$HERE/SynthLib/ThirdParty/freetype/include")

# glfw is here for its HEADERS ONLY - SynthLib's key and mouse constants come from them, which is
# enum leakage rather than a dependency, so the library itself is never built or linked. freetype
# genuinely is one: the panel renders text through it.
FREETYPE_LIB="$HERE/SynthLib/ThirdParty/freetype/build/libfreetype.a"

if [[ ! -f "$FREETYPE_LIB" ]]; then
    print -u2 "error: freetype not built at $FREETYPE_LIB"
    print -u2 "       see the build notes in G2-Edit/Docs/Third Party build notes.txt"
    exit 1
fi

MST_VERSION="${MST_VERSION:-0.1.0}"
# G2_VST3_BUILD is SynthLib's "this is a plug-in, there is no GLFW" switch, and it is what compiles
# the GLFW calls out of renderBackendGL.c's gl_present(). The name is G2-specific for historical
# reasons; all four projects set it in their plug-in builds.
PLUGIN_DEFS=(-DG2_VST3_BUILD=1 -DMST_VERSION_STRING="\"$MST_VERSION\"")

rm -rf "$OUT"
mkdir -p "$OUT/Contents/MacOS"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

print "building MidiSyncTool.vst3 (arm64 + x86_64)"

for ARCH in arm64 x86_64; do
    OBJS=()

    for SRC in "${C_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.c})-$ARCH.o"
        clang -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu11 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${OBJC_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.m})-objc-$ARCH.o"
        clang -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu11 -O2 -Wall -Wextra -fobjc-arc "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${OBJCPP_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.mm})-objcpp-$ARCH.o"
        clang++ -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu++17 -O2 -Wall -Wextra -fobjc-arc "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${CPP_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.cpp})-$ARCH.o"
        clang++ -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu++17 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    clang++ -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
        -dynamiclib -o "$WORK/MidiSyncTool-$ARCH" "${OBJS[@]}" "$FREETYPE_LIB" \
        -framework CoreFoundation -framework CoreAudio -framework CoreMIDI \
        -framework Cocoa -framework Metal -framework QuartzCore -framework OpenGL
done

lipo -create -output "$BIN" "$WORK/MidiSyncTool-arm64" "$WORK/MidiSyncTool-x86_64"

# A bundle needs its Info.plist and the four-character PkgInfo, or the host will not look inside it.
cat > "$OUT/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>MidiSyncTool</string>
    <key>CFBundleIdentifier</key><string>com.chrispurusha.midisynctool.vst3</string>
    <key>CFBundleName</key><string>MidiSyncTool</string>
    <key>CFBundlePackageType</key><string>BNDL</string>
    <key>CFBundleSignature</key><string>????</string>
    <key>CFBundleShortVersionString</key><string>$MST_VERSION</string>
    <key>CFBundleVersion</key><string>$MST_VERSION</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSMinimumSystemVersion</key><string>11.5</string>
</dict>
</plist>
PLIST

printf 'BNDL????' > "$OUT/Contents/PkgInfo"

codesign --force --sign - "$OUT" 2>/dev/null || print -u2 "warning: ad-hoc signing failed"

print ""
print "Built: $OUT"
print "Architectures: $(lipo -archs "$BIN")"

# Installed straight into the VST3 folder, replaced rather than merged - a cp -R onto an existing
# bundle leaves files dropped from the build still installed and still being loaded.
INSTALL_DIR="${MST_VST3_INSTALL:-/Library/Audio/Plug-Ins/VST3}"
INSTALLED="$INSTALL_DIR/$(basename "$OUT")"

# A BUILD SENT SOMEWHERE ELSE IS NOT A BUILD TO INSTALL, and this guard exists because the omission
# was made and did real damage. Building an old revision for an A/B with MST_VST3_OUT=/tmp/mst-old.vst3
# and no MST_NO_INSTALL put a stale plug-in into /Library/Audio/Plug-Ins/VST3 as "mst-old.vst3" -
# a DIFFERENT bundle name declaring the SAME VST3 class IDs as MidiSyncTool.vst3. A host indexes by
# class id, so it then had two bundles claiming to be this plug-in and was free to load either.
#
# Naming the output explicitly always means "put it there, for a purpose of my own". Only the default
# output is the developer's working copy, so only that one is installed.
if [[ -n "$MST_NO_INSTALL" ]]; then
    print ""
    print "Not installed (MST_NO_INSTALL is set)."
elif [[ "$OUT" != "$DEFAULT_OUT" ]]; then
    print ""
    print "Not installed: MST_VST3_OUT names a build of its own, not the working copy."
    print "               (set MST_VST3_INSTALL if you really want it installed somewhere)"
else
    rm -rf "$INSTALLED"
    cp -R "$OUT" "$INSTALL_DIR/" && print "Installed: $INSTALLED"
fi

print ""
print "Logging is OFF until the gate file exists:"
print "    touch /tmp/midisynctool-log     # then reload the plug-in in the host"
print "    tail -f /tmp/midisynctool.log"
