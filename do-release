#!/bin/zsh

# Builds a universal (arm64 + x86_64) MidiSyncTool.vst3 and packages it as a .dmg
# ready to attach to a GitHub release.
#
# There is no application here - MidiSyncTool is a plug-in and nothing else - so
# this is the plug-in equivalent of G2-Edit/do-release, and deliberately reads
# like it. The version scheme, the ad-hoc signing, the quarantine instructions
# travelling inside the .dmg and the "never create the tag" rule are all the same.
#
# Versions are semver: V<major>.<minor>.<patch>-beta.<n>. The .dmg is normally
# built BEFORE the tag exists, so name the part you are bumping and the next
# version is worked out from the newest existing tag:
#
#   ./do-release beta      V0.1.0-beta.1 -> V0.1.0-beta.2   (the usual one)
#   ./do-release patch     V0.1.0-beta.1 -> V0.1.1-beta.1
#   ./do-release minor     V0.1.0-beta.1 -> V0.2.0-beta.1
#   ./do-release major     V0.1.0-beta.1 -> V1.0.0-beta.1
#   ./do-release final     V0.1.0-beta.1 -> V0.1.0           (drops -beta.n)
#
#   ./do-release 0.9.0-rc1 an explicit version, used as given
#   ./do-release           reuse the newest tag as-is (rebuild an old release)
#   ./do-release beta ~/tmp any of the above, into a different directory
#
# THERE ARE NO TAGS IN THIS REPOSITORY YET, so the first release has to name its
# version explicitly - ./do-release 0.1.0-beta.1 - and every one after it can use
# a keyword.
#
# Under semver, 0.x.y means the interface is still unstable, so bumping to 1.0.0
# is a deliberate statement that it has settled.
#
# This script never creates or pushes the tag - it prints the git command for you
# to run once you are happy with the .dmg.
#
# The .dmg lands on the Desktop by default - outside the repo, so it is easy to
# drag onto a GitHub release and can never be committed by accident.
#
# Ad-hoc signed only. There is no paid Apple Developer membership behind this
# project, so the .dmg is NOT notarized and a host will refuse to load the
# plug-in until the quarantine flag is cleared. Those instructions are written
# into the .dmg as "Read Me First.txt" so they travel with the download.

set -e

ARG_BUMP="$1"

# Resolve a relative output path against the caller's directory, not the project
# directory we are about to switch to.
DIST="${2:-$HOME/Desktop}"
DIST="${DIST:a}"

cd ${0:a:h}

VST3_NAME="MidiSyncTool.vst3"
VOL_NAME="MidiSyncTool"

# OUTSIDE THE PROJECT, AND REMOVED ON THE WAY OUT. Both halves of that matter, and
# the reason is a real afternoon lost to it.
#
# This used to build into build/release-tmp and leave it there. The result was a
# SECOND MidiSyncTool.vst3, correctly formed and identically named, sitting inside
# a directory a host may well be scanning - and VST3 scanning recurses. Live found
# both, loaded the stale one, and presented an old build's GUI with no indication
# that anything was wrong. It reads exactly like a regression in the plug-in, and
# it is not: it is two bundles with one name.
#
# A temporary directory cannot be on any host's search path, and the trap removes
# it whether the release succeeds, fails a check, or is interrupted. STAGE joins
# the same trap further down rather than installing a second one that would
# replace this.
DERIVED=$(mktemp -d)
STAGE=""
trap 'rm -rf "$DERIVED" "$STAGE"' EXIT

# --- version -------------------------------------------------------------

# Git tags are the source of truth. MST_VERSION's default inside do-vst3 is a
# placeholder for developer builds and is deliberately overridden here.
#
# --sort=-v:refname orders by version rather than alphabetically, so beta.10 is
# correctly newer than beta.9. --abbrev=0 on describe would give the tag nearest
# HEAD, which is not the same thing once branches are involved.
LATEST=$(git tag --list --sort=-v:refname 'V*' 2>/dev/null | head -1)
NEW_TAG=""

case "$ARG_BUMP" in
    major|minor|patch|beta|final)
        if [[ -z $LATEST ]]; then
            echo "error: no existing V* tag to bump from." >&2
            echo "       give an explicit version instead: ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi

        # V<major>.<minor>.<patch>[-beta.<n>]
        if [[ ! $LATEST =~ '^[Vv]([0-9]+)\.([0-9]+)\.([0-9]+)(-beta\.([0-9]+))?$' ]]; then
            echo "error: newest tag '$LATEST' is not V<n>.<n>.<n>[-beta.<n>]," >&2
            echo "       so it cannot be bumped. Give an explicit version instead." >&2
            exit 1
        fi

        MAJOR=$match[1]
        MINOR=$match[2]
        PATCH=$match[3]
        BETA=$match[5]

        case "$ARG_BUMP" in
            major) (( MAJOR++ )); MINOR=0; PATCH=0; BETA=1 ;;
            minor) (( MINOR++ ));          PATCH=0; BETA=1 ;;
            patch) (( PATCH++ ));                   BETA=1 ;;
            beta)
                if [[ -z $BETA ]]; then
                    echo "error: '$LATEST' has no -beta.n to bump." >&2
                    echo "       use 'patch' to start a new beta series." >&2
                    exit 1
                fi
                (( BETA++ ))
                ;;
            final) BETA="" ;;
        esac

        if [[ -n $BETA ]]; then
            NEW_TAG="V$MAJOR.$MINOR.$PATCH-beta.$BETA"
        else
            NEW_TAG="V$MAJOR.$MINOR.$PATCH"
        fi

        if git rev-parse -q --verify "refs/tags/$NEW_TAG" >/dev/null; then
            echo "error: tag $NEW_TAG already exists." >&2
            exit 1
        fi

        VERSION="$NEW_TAG"
        echo "==> version $VERSION ($ARG_BUMP bump from $LATEST)"
        ;;

    "")
        if [[ -z $LATEST ]]; then
            echo "error: no git tag found and no version given." >&2
            echo "       this project has no tags yet, so name the first one:" >&2
            echo "           ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi

        VERSION="$LATEST"
        echo "==> version $VERSION (reusing newest tag)"

        # Only meaningful when reusing an existing tag. When bumping, HEAD being
        # ahead of the previous tag is the whole point.
        if [[ -n $(git rev-list "$LATEST"..HEAD 2>/dev/null) ]]; then
            echo "    WARNING: HEAD is ahead of $LATEST - this .dmg contains code" >&2
            echo "             that is not in that tag. Did you mean ./do-release beta?" >&2
        fi
        ;;

    *)
        # An explicit version. Require it to start like one, so a mistyped keyword
        # ("bета", "pacth") is caught here instead of producing MidiSyncTool-pacth.dmg.
        if [[ ! $ARG_BUMP =~ '^[Vv]?[0-9]+\.' ]]; then
            echo "error: '$ARG_BUMP' is not a bump keyword or a version number." >&2
            echo "       keywords: major minor patch beta final" >&2
            echo "       or give a version: ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi

        VERSION="$ARG_BUMP"
        echo "==> version $VERSION (specified)"
        ;;
esac

if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    echo "    WARNING: working tree has uncommitted changes" >&2
fi

# Strip a leading V/v for filenames and the volume title: tags read "V0.1.0", but
# "MidiSyncTool-0.1.0.dmg" is the conventional artifact name.
VERSION_CLEAN="${VERSION#[Vv]}"

# --- build ---------------------------------------------------------------

echo "==> clean build, universal"

# BUILT IN ITS OWN TEMPORARY TREE, not the shared build/ directory - the same rule
# G2-Edit's release learned the hard way. build/MidiSyncTool.vst3 is the copy a
# developer has installed for testing, and a release must neither overwrite it nor
# race anything else writing there. See the DERIVED note at the top for why it is
# no longer a subdirectory of build/ either.
#
# MST_NO_INSTALL matters just as much: do-vst3 installs into
# /Library/Audio/Plug-Ins/VST3 by default, and making a .dmg is not consent to
# replace the plug-in the machine is currently running.
if ! MST_VERSION="$VERSION_CLEAN" \
     MST_VST3_OUT="$DERIVED/$VST3_NAME" \
     MST_NO_INSTALL=1 \
     ./do-vst3 >/dev/null; then
    echo "error: the VST3 build failed - run ./do-vst3 on its own for the reason" >&2
    echo "       (needs the VST3 SDK; set VST3_SDK if it is not in ~/Documents/vst3sdk)" >&2
    exit 1
fi

VST3_BUNDLE="$DERIVED/$VST3_NAME"

if [[ ! -d $VST3_BUNDLE ]]; then
    echo "error: do-vst3 reported success but $VST3_BUNDLE is not there" >&2
    exit 1
fi

# --- verify --------------------------------------------------------------

BINARY="$VST3_BUNDLE/Contents/MacOS/MidiSyncTool"
ARCHS=$(lipo -archs "$BINARY" 2>/dev/null || echo "")

# A single-architecture plug-in would load for half the users and be invisible to
# the other half, with no error either side could act on.
if [[ $ARCHS != *arm64* || $ARCHS != *x86_64* ]]; then
    echo "error: expected a universal binary, got '$ARCHS'" >&2
    exit 1
fi

echo "==> built $ARCHS"

# Confirm the version actually reached the bundle, so the .dmg name and what the
# host reports can never disagree.
PLIST_VERSION=$(defaults read "${VST3_BUNDLE:a}/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "")

if [[ $PLIST_VERSION != $VERSION_CLEAN ]]; then
    echo "error: Info.plist says '$PLIST_VERSION', expected '$VERSION_CLEAN'" >&2
    exit 1
fi

echo "==> bundle version $PLIST_VERSION"

# --- sign ----------------------------------------------------------------

# Ad-hoc signature. Not a substitute for notarization, but it keeps the bundle
# internally consistent so it loads once quarantine is cleared. do-vst3 signs it
# too; this re-signs after xattr -cr, because clearing extended attributes
# invalidates the signature that was there.
echo "==> ad-hoc signing"
xattr -cr "$VST3_BUNDLE"
codesign --force --options runtime --sign - "$VST3_BUNDLE"
codesign --verify --strict "$VST3_BUNDLE"

# --- stage ---------------------------------------------------------------

echo "==> staging disk image contents"

# Volume names are capped at 27 characters on HFS+, and "MidiSyncTool " already
# spends 13 of them - so the version is what gets trimmed if anything does.
# WORKED OUT HERE, before the Read Me is written, because the Read Me quotes a
# /Volumes/... path: a truncation the two disagreed about would hand the user a
# copy line that silently does nothing.
VOLUME="$VOL_NAME $VERSION_CLEAN"
VOLUME="${VOLUME[1,27]}"

# NO NEW TRAP HERE. The one set beside DERIVED covers both, and a second trap on
# EXIT would silently replace the first - leaving the build tree behind again,
# which is the whole thing this is guarding against.
STAGE=$(mktemp -d)

cp -R "$VST3_BUNDLE" "$STAGE/"

# NO SYMLINK TO THE VST3 FOLDER, deliberately. /Library/Audio/Plug-Ins/VST3 could
# be linked to, but the per-user alternative lives under the builder's own home
# directory and a symlink baked into a .dmg would point at the machine that built
# it. The Read Me First covers it with a Terminal line and a Finder route instead.

cat > "$STAGE/Read Me First.txt" <<EOF
$VOL_NAME $VERSION_CLEAN
========================

WHAT IT IS

MidiSyncTool is a VST3 plug-in that generates MIDI clock from your DAW's own
musical timeline, and then measures what your hardware actually did with it.

It does two jobs:

  - it sends a clock steadier than the host's audio callback, by modelling
    where musical time falls on the wall clock instead of stamping each tick
    with the moment its audio block happened to arrive;

  - it listens to an audio input, finds the transients your drum machine or
    sequencer produced, and reports the round trip, the jitter and how much of
    it is left after compensation.

It can do both at once, or either on its own. Measuring is the setting-up job;
once you know what your hardware does, leave it generating the clock and
nothing else. That is what the Mode control below is for.

There is no application - the plug-in is the whole thing, and it needs a VST3
host to run in.

STEP 1 - INSTALL

Copy "$VST3_NAME" into your VST3 folder. In Terminal:

    cp -R "/Volumes/$VOLUME/$VST3_NAME" /Library/Audio/Plug-Ins/VST3/

Or in Finder: choose Go > Go to Folder, enter

    /Library/Audio/Plug-Ins/VST3

and drag "$VST3_NAME" from this window into it.

That is the system-wide plug-in folder, which is where installers put things and
where hosts look first. On an administrator account it is writable without any
special step. If Terminal says "Permission denied", or the folder does not exist
at all, put sudo in front of the line and it will ask for your password.

There is a second, per-user folder at ~/Library/Audio/Plug-Ins/VST3 which also
works. Use one or the other - a copy in both means your host may list the
plug-in twice and load whichever it finds first.

STEP 2 - UNLOCK

This plug-in is not notarized by Apple, so macOS quarantines it and your host
will refuse to load it with no useful explanation - usually by simply not
listing it after a scan. Open Terminal and run:

    xattr -dr com.apple.quarantine /Library/Audio/Plug-Ins/VST3/"$VST3_NAME"

It prints nothing if it worked. You only need to do this once, and again after
each update. If you installed to the per-user folder instead, change the path in
the command to match.

Then rescan plug-ins in your host - most do it at startup. It appears as
"MidiSyncTool" by Chris Purusha.

USING IT

Put it on a track. The SETUP rows at the top of its panel are:

  Port          the MIDI destination to send clock to. It starts at "none",
                deliberately: a plug-in that picks a port on your behalf ends up
                driving hardware nobody asked it to.

  Analyse       which side of that track's audio input to listen to for the
                hardware's transients. Feed the device's audio back into the
                track for the latency and jitter figures to mean anything.
                It has no effect in Generate clock only, where nothing is
                being listened for.

  Compensation  how far ahead of the beat to place the clock, to cancel the
                device's own round trip. The panel measures that round trip for
                you; dial it in here and watch the residual figure fall.

  Mode          what the plug-in is doing, and therefore which of the figures
                under it mean anything. Three settings:

                Generate + measure - sends the clock AND listens to the audio
                coming back. This is the one to set up in: it is the only mode
                that produces a round trip to compensate for.

                Generate clock only - sends the clock and listens to nothing.
                THIS IS THE EVERYDAY SETTING. Once a device's latency is known
                the plug-in is simply a clock, and it can then sit on any track
                you like. Left in Generate + measure on a track your hardware
                does not come back on, it counts a missed hit every beat - some
                7800 an hour - and reads as a fault when nothing is wrong.

                Monitor - sends nothing at all and instead fits a grid to
                whatever is already playing, for measuring a master you do not
                control.

  Clock in      a MIDI input to time an incoming clock on, reported as its own
                figures under CLOCK INPUT: somebody else's master, or this
                plug-in's own output looped back through a virtual port. It
                measures only - nothing steers the generated clock from it -
                and it runs in every mode, including Monitor.

Start the transport and the figures fill in. In Generate clock only there is
nothing to measure, so MEASURED DEVICE reads as dashes, or holds the numbers
from your last measuring run and says HELD over them - the compensation in
force came out of those, so they are kept rather than blanked.

"Quality" is the one-word verdict: under a quarter of a millisecond of jitter
is better than any hardware sequencer, over two is audible as sloppiness on a
fast pattern.

REQUIREMENTS

macOS 11.5 or later, Apple Silicon or Intel.
A VST3 host. It does not work on its own.
EOF

# --- package -------------------------------------------------------------

mkdir -p $DIST
DMG="$DIST/$VOL_NAME-$VERSION_CLEAN.dmg"
rm -f "$DMG"

echo "==> creating $DMG"

hdiutil create \
    -volname "$VOLUME" \
    -srcfolder "$STAGE" \
    -fs HFS+ \
    -format UDZO \
    -ov \
    "$DMG" >/dev/null

echo
echo "done: $DMG ($(du -h "$DMG" | cut -f1))"
echo "contents: $VST3_NAME ($ARCHS)"
echo "signature: ad-hoc, NOT notarized - users must clear quarantine"

if [[ -n $NEW_TAG ]]; then
    echo
    echo "$NEW_TAG does not exist yet. Once you are happy with the .dmg:"
    echo
    echo "    git tag -a $NEW_TAG -m \"$NEW_TAG\""
    echo "    git push origin $NEW_TAG"
elif [[ $ARG_BUMP != "" ]]; then
    echo
    echo "V$VERSION_CLEAN does not exist yet. Once you are happy with the .dmg:"
    echo
    echo "    git tag -a V$VERSION_CLEAN -m \"V$VERSION_CLEAN\""
    echo "    git push origin V$VERSION_CLEAN"
fi
