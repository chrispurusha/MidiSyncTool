#!/bin/zsh
# Build the headless timing driver. See tools/mstDriver.cpp for what it is and why it lies.
set -e
SDK="${VST3_SDK:-$HOME/Documents/vst3sdk}"
HERE="$(cd "$(dirname "$0")" && pwd)"

# The C parts are compiled as C - device.c and ring.c use _Atomic and designated initialisers that a
# C++ compiler either refuses or means something different by.
#
# THEY COME FROM SynthLib NOW (SynthLib/audio), not from src/. They were msDevice.c and msRing.c,
# copies of GenBridge's that had silently drifted from them - see SynthLib/TODO.md.
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

for SRC in device ring; do
    clang -c -O2 -std=gnu11 -Wall -Wextra -I "$HERE/../SynthLib/audio" \
        -o "$WORK/$SRC.o" "$HERE/../SynthLib/audio/$SRC.c"
done

clang++ -O2 -std=gnu++17 -Wall -Wextra \
    -I "$SDK" -I "$HERE/../src" -I "$HERE/../SynthLib/audio" \
    -o "$HERE/mstDriver" \
    "$HERE/mstDriver.cpp" \
    "$WORK/device.o" "$WORK/ring.o" \
    "$SDK/pluginterfaces/base/funknown.cpp" \
    "$SDK/pluginterfaces/base/coreiids.cpp" \
    "$SDK/public.sdk/source/vst/vstinitiids.cpp" \
    -framework CoreFoundation -framework CoreMIDI -framework CoreAudio

print "Built: $HERE/mstDriver"
